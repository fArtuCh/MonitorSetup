<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinForms UI, command line and the composition root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MonitorSetup</AssemblyName>
    <RootNamespace>MonitorSetup.App</RootNamespace>
    <AssemblyTitle>Monitor Setup</AssemblyTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- `dotnet publish` produces one self-contained MonitorSetup.exe that runs without .NET installed.
       Normal builds stay framework-dependent so they are fast and can be referenced. -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonitorSetup.Core\MonitorSetup.Core.csproj" />
    <ProjectReference Include="..\MonitorSetup.Infrastructure.Windows\MonitorSetup.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
